@{
    ViewData["Title"] = "Yeni Sipariş";
    ViewData["Nav"] = "order";
    var customers = (List<Customer>)ViewBag.Customers;
    var back = Url.Action("Index", "Home");
}
@* Görünüm referans musteritakip.html → #orderModal. Ana sayfadan data-modal ile pencere olarak açılır;
   doğrudan açılırsa da pencere açık gelir, kapatınca ana sayfaya döner. *@
<div class="confirm-modal open" id="pickCustModal" data-standalone data-back="@back">
    <form class="confirm-card pay-card order-card" id="pickCustForm" method="get" asp-controller="Orders" asp-action="Create"
          role="dialog" aria-modal="true" aria-labelledby="pickCustTitle" novalidate>
        <div class="pay-head">
            <h2 id="pickCustTitle">Yeni Sipariş</h2>
            <button type="button" class="x-close" aria-label="Kapat">✕</button>
        </div>
        <p class="pay-cust">Siparişi hangi müşteriye kaydedelim?</p>
        <div class="field pc-field">
            <label for="pickCust">Müşteri</label>
            <div class="pc-wrap">
                <input type="text" id="pickCust" class="upper" autocomplete="off" autocapitalize="characters" spellcheck="false"
                       placeholder="Seçin / yazın" autofocus role="combobox" aria-expanded="false" aria-controls="pickCustList" aria-autocomplete="both" />
                <button type="button" class="pc-clear" tabindex="-1" aria-label="Müşteri adını sil" title="Sil" hidden>×</button>
                <button type="button" class="pc-caret" tabindex="-1" aria-label="Müşterileri listele">▾</button>
                <ul class="pc-list" id="pickCustList" role="listbox" hidden>
                    @foreach (var c in customers)
                    {
                        <li role="option" data-id="@c.Id" data-name="@c.Name">@c.Name</li>
                    }
                </ul>
            </div>
        </div>
        <div class="pc-drop" id="pickDrop" hidden><span class="pc-drop-img"><img alt="" /><button type="button" class="pc-drop-x" title="Resmi kaldır" aria-label="Resmi kaldır">×</button></span><span>Bu resim siparişe eklenecek · değiştirmek için üstüne başka resim sürükleyin</span></div>
        <input type="hidden" name="customerId" id="pickCustId" />
        <p class="pm-error" id="pickErr" role="alert"></p>
        <div class="confirm-actions">
            <button type="submit" class="btn" id="pickGo">Devam</button>
        </div>
    </form>
    <script>
        (function () {
            var m = document.getElementById('pickCustModal'), f = document.getElementById('pickCustForm');
            if (!f || f.__wired) return; f.__wired = true;
            var inp = document.getElementById('pickCust'), hid = document.getElementById('pickCustId'),
                list = document.getElementById('pickCustList'), caret = f.querySelector('.pc-caret'), clr = f.querySelector('.pc-clear'),
                go = document.getElementById('pickGo'), err = document.getElementById('pickErr'),
                items = Array.prototype.slice.call(list.querySelectorAll('li')), active = -1;
            // "Yeni Sipariş" butonuna resim bırakıldıysa önizlemesini göster (sipariş kartına aktarılacak)
            var pd = document.getElementById('pickDrop'), pimg = pd.querySelector('img');
            function setDrop(file) {
                try { if (pimg.src && pimg.src.indexOf('blob:') === 0) URL.revokeObjectURL(pimg.src); } catch (x) { }
                window.__dropImg = file || null;
                if (!file) { pimg.removeAttribute('src'); pd.hidden = true; return; }
                try { pimg.src = URL.createObjectURL(file); pd.hidden = false; } catch (x) { }
            }
            if (window.__dropImg) setDrop(window.__dropImg);
            // × : yanlış resmi kaldır
            pd.querySelector('.pc-drop-x').addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); setDrop(null); inp.focus(); });
            // Karta başka resim sürükleyip bırakınca eklenen resim değişir (resim yoksa eklenir)
            var hasFiles = function (e) { try { return Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0; } catch (x) { return false; } };
            var depth = 0;
            f.addEventListener('dragenter', function (e) { if (!hasFiles(e)) return; e.preventDefault(); depth++; f.classList.add('dz-over'); });
            f.addEventListener('dragover', function (e) { if (!hasFiles(e)) return; e.preventDefault(); try { e.dataTransfer.dropEffect = 'copy'; } catch (x) { } });
            f.addEventListener('dragleave', function () { depth = Math.max(0, depth - 1); if (!depth) f.classList.remove('dz-over'); });
            f.addEventListener('drop', function (e) {
                if (!hasFiles(e)) return;
                e.preventDefault(); e.stopPropagation(); depth = 0; f.classList.remove('dz-over');
                var file = Array.prototype.find.call(e.dataTransfer.files || [], function (x) { return /^image\//i.test(x.type || ''); });
                if (file) setDrop(file);
            });
            var up = function (s) { return (s || '').trim().toLocaleUpperCase('tr-TR'); };
            var visible = function () { return items.filter(function (li) { return !li.hidden; }); };
            var match = function () { var v = up(inp.value); return items.filter(function (li) { return up(li.dataset.name) === v; })[0]; };

            function setActive(i) {
                var vis = visible(); items.forEach(function (li) { li.classList.remove('on'); li.removeAttribute('aria-selected'); });
                active = vis.length ? Math.max(0, Math.min(i, vis.length - 1)) : -1;
                if (active >= 0) { vis[active].classList.add('on'); vis[active].setAttribute('aria-selected', 'true'); vis[active].scrollIntoView({ block: 'nearest' }); }
            }
            function filter(all) {
                if (all) { items.forEach(function (li) { li.hidden = false; }); return; }
                // Seçili (otomatik tamamlanan) kısım hariç yazılan metne göre süz
                var typed = up(inp.value.slice(0, inp.selectionStart === inp.selectionEnd ? inp.value.length : inp.selectionStart));
                items.forEach(function (li) { li.hidden = typed !== '' && up(li.dataset.name).indexOf(typed) === -1; });
            }
            // all: kutuya / oka tıklanınca seçili bir isim varsa bütün liste gösterilir (seçili olan işaretli)
            function open(all) {
                filter(all === true && !!match());
                var any = visible().length > 0;
                list.hidden = !any; inp.setAttribute('aria-expanded', any ? 'true' : 'false');
                if (any) { var mt = match(); setActive(mt ? visible().indexOf(mt) : -1); }
            }
            function close() { list.hidden = true; inp.setAttribute('aria-expanded', 'false'); active = -1; }
            function pick(li) {
                inp.value = li.dataset.name; hid.value = li.dataset.id;
                err.textContent = ''; close(); syncClr();
                go.focus();   // Devam'a geç — Enter işlemi tamamlar
            }

            function syncClr() { clr.hidden = inp.value === ''; }
            inp.addEventListener('click', function () { open(true); });   // kutuya tıklayınca kayıtlı müşteriler listelenir
            caret.addEventListener('mousedown', function (e) { e.preventDefault(); if (list.hidden) { inp.focus(); open(true); } else close(); });
            // × : müşteri adını sil
            clr.addEventListener('mousedown', function (e) { e.preventDefault(); });
            clr.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();
                inp.value = ''; hid.value = ''; err.textContent = ''; syncClr(); inp.focus(); open();
            });
            list.addEventListener('mousedown', function (e) { e.preventDefault(); var li = e.target.closest('li'); if (li) pick(li); });
            inp.addEventListener('blur', function () { setTimeout(close, 120); });

            inp.addEventListener('input', function (e) {
                hid.value = ''; err.textContent = ''; syncClr();
                var typed = up(inp.value);
                // Yazarken ismi otomatik tamamla (silerken tamamlama yapma)
                if (typed && e.inputType && e.inputType.indexOf('delete') !== 0) {
                    var hit = items.filter(function (li) { return up(li.dataset.name).indexOf(typed) === 0; })[0];
                    if (hit) {
                        var n = inp.value.length;
                        inp.value = hit.dataset.name;
                        try { inp.setSelectionRange(n, inp.value.length); } catch (x) { }
                    }
                }
                open();
            });

            inp.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (list.hidden) { open(true); return; }
                    setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    var li = (!list.hidden && active >= 0 && visible()[active]) || match();
                    if (!li) {   // tek eşleşme kaldıysa onu al
                        var vis = visible(); if (!list.hidden && vis.length === 1) li = vis[0];
                    }
                    if (li) pick(li); else showErr();
                } else if (e.key === 'Escape' && !list.hidden) {
                    e.preventDefault(); e.stopPropagation(); close();
                } else if (e.key === 'Tab' && !list.hidden && active >= 0) {
                    var t = visible()[active]; if (t) { inp.value = t.dataset.name; hid.value = t.dataset.id; close(); }
                }
            });

            function showErr() {
                var v = up(inp.value);
                err.textContent = v ? 'Bu isimde kayıtlı müşteri yok. Listeden bir müşteri seçin.' : 'Lütfen müşteriyi seçin.';
                inp.focus();
            }

            f.addEventListener('submit', function (e) {
                var li = match();
                if (!li) { e.preventDefault(); showErr(); return; }
                hid.value = li.dataset.id;
                // Pencere olarak açıldıysa sipariş formu da sayfadan ayrılmadan pencerede açılsın
                if (!m.hasAttribute('data-standalone')) {
                    e.preventDefault();
                    var a = document.createElement('a');
                    a.href = f.getAttribute('action') + '?customerId=' + encodeURIComponent(li.dataset.id);
                    a.setAttribute('data-modal', ''); a.hidden = true;
                    document.body.appendChild(a); a.click(); a.remove();
                    m.remove();
                }
            });
        })();
    </script>
</div>
