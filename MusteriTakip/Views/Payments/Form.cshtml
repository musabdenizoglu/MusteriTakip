@model PaymentFormVm
@{
    var isNew = Model.Id == null;
    ViewData["Title"] = isNew ? "Ödeme Ekle" : "Ödemeyi Düzenle";
    var pickCustomer = isNew && Model.FromKasa && !(Model.CustomerId > 0);
    var back = Model.CustomerId > 0 ? Url.Action("Details", "Customers", new { id = Model.CustomerId, tab = "cari" }) : Url.Action("Index", "Kasa");
    var hasGold = Model.GoldRemaining > 0.0005m;
    // Düzenlemede görünen kutuya dolacak değerler (tek ödeme türü dolu olur)
    var usdIn = Model.PayType == "usd" && Model.Amount > 0 ? Fmt.Input(Model.Amount.Value) : "";
}
@* Görünüm referans musteritakip.html → #payModal (#dnFields: tür seçimsiz ödeme kartı).
   Görünen kutular (data-dn) kullanıcıya aittir; sunucuya giden alanlar gizlidir ve site.js doldurur. *@
<div class="confirm-modal open" id="payModal" data-standalone data-back="@back">
<form method="post" asp-controller="Payments" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" class="confirm-card pay-card" id="payForm" data-dn-pay
      role="dialog" aria-modal="true" aria-labelledby="payModalTitle"
      data-gold-remaining="@Fmt.Input(Model.GoldRemaining)" data-prev="@Fmt.Input(Model.PrevBalance)" novalidate>
    <div class="pay-head">
        <h2 id="payModalTitle">@ViewData["Title"]</h2>
        <button type="button" class="x-close" aria-label="Kapat">✕</button>
    </div>
    @if (!pickCustomer)
    {
        <p class="pay-cust">@Model.CustomerName</p>
        <input type="hidden" asp-for="CustomerId" />
    }
    <input type="hidden" asp-for="FromKasa" />
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" data-return-url />
    <input type="hidden" asp-for="Kind" />
    <input type="hidden" asp-for="Method" />
    <input type="hidden" asp-for="PayType" data-dn-type />
    <input type="hidden" asp-for="Amount" data-dn-amount />
    <input type="hidden" name="CountAsCash" value="@(Model.CountAsCash ? "true" : "false")" data-dn-cash />

    <div class="pm-grid dn-grid">
        @if (pickCustomer)
        {
            <div class="field pm-full">
                <label asp-for="CustomerName">Müşteri</label>
                <input asp-for="CustomerName" list="pmCustList" class="upper" autocomplete="off" placeholder="Seçin / yazın" />
                <datalist id="pmCustList">
                    @foreach (var c in Model.Customers)
                    {
                        <option value="@c.Name"></option>
                    }
                </datalist>
            </div>
        }
        <div class="field" data-g="usd"><label for="dnUsd">Tutar ($)</label><input type="number" id="dnUsd" min="0" step="0.01" placeholder="0,00" value="@usdIn" data-dn="usd" /></div>
        <div class="field" data-g="tl"><label for="dnTl">Tutar (₺)</label><input type="number" id="dnTl" name="Tl" min="0" step="0.01" placeholder="0,00" value="@(Model.PayType == "tl" && Model.Tl > 0 ? Fmt.Input(Model.Tl.Value) : "")" data-dn="tl" /></div>
        <div class="field" data-g="eur"><label for="dnEur">Tutar (€)</label><input type="number" id="dnEur" name="Eur" min="0" step="0.01" placeholder="0,00" value="@(Model.PayType == "eur" && Model.Eur > 0 ? Fmt.Input(Model.Eur.Value) : "")" data-dn="eur" /></div>

        <div class="field pm-full" data-g="gr"><label for="dnGram">Altın (gr)</label><input type="number" id="dnGram" name="Gram" min="0" step="0.001" placeholder="0,000" value="@(Model.PayType == "gr" && Model.Gram > 0 ? Fmt.Input(Model.Gram.Value) : "")" data-dn="gr" /></div>

        <div class="field" data-g="hurda"><label for="dnHurdaGr">Hurda (gr)</label><input type="number" id="dnHurdaGr" name="HurdaGr" min="0" step="0.01" placeholder="0,00" value="@(Model.PayType == "hurda" && Model.HurdaGr > 0 ? Fmt.Input(Model.HurdaGr.Value) : "")" data-dn="hurda" /></div>
        <div class="field" data-g="hurda"><label for="dnHurdaMil">Milyem</label><input type="number" id="dnHurdaMil" name="HurdaMil" min="0" max="1000" step="1" placeholder="585" value="@(Model.PayType == "hurda" && Model.HurdaMil > 0 ? Fmt.Input(Model.HurdaMil.Value) : "")" data-dn="hurda" /></div>
        <div class="field"><label for="dnHas">Has karşılığı</label><input type="text" id="dnHas" readonly tabindex="-1" placeholder="—" /></div>

        <div class="field" id="dnGoldPWrap" hidden><label for="dnGoldP">Altın fiyatı ($/gr)</label><input type="number" id="dnGoldP" name="GoldPrice" min="0" step="0.01" placeholder="örn. 130,00" value="@(Model.GoldPrice > 0 ? Fmt.Input(Model.GoldPrice.Value) : "")" /></div>
        <div class="field" id="dnRateWrap" hidden><label for="dnRate">$/TL kuru</label><input type="number" id="dnRate" name="Rate" min="0" step="0.0001" placeholder="örn. 41,25" value="@(Model.Rate > 0 ? Fmt.Input(Model.Rate.Value) : "")" /></div>
        <div class="field" id="dnEurRateWrap" hidden><label for="dnEurRate">€/$ paritesi</label><input type="number" id="dnEurRate" name="EurRate" min="0" step="0.0001" placeholder="örn. 1,1600" value="@(Model.EurRate > 0 ? Fmt.Input(Model.EurRate.Value) : "")" /></div>

        @if (hasGold)
        {
            <div class="pm-full gold-close" id="pmGoldClose">
                <label class="gc-chk"><input type="checkbox" id="dnGoldChk" @(Model.CountAsCash ? "" : "checked") /> <span id="dnGoldText">Bu ödeme altın borcuna sayılsın</span></label>
                <div class="gc-info" id="pmGoldCloseInfo">Kalan altın borcu: <b>@Fmt.Gr(Model.GoldRemaining)</b></div>
                <div class="gc-row">
                    <button type="button" class="btn secondary sm" id="pmGoldCloseBtn">Altın borcunu nakit kapat</button>
                    <div class="gc-price"><label for="pmGoldEqPriceIn">Altın fiyatı ($/gr)</label><input type="number" id="pmGoldEqPriceIn" name="GoldEqPrice" min="0" step="0.01" placeholder="örn. 130,00" value="@(Model.GoldEqPrice > 0 ? Fmt.Input(Model.GoldEqPrice.Value) : "")" /></div>
                </div>
            </div>
        }

        <div class="field dn-date"><label asp-for="Date">Tarih</label><input asp-for="Date" type="date" title="Boş bırakılırsa bugünün tarihi yazılır" /></div>
        <div class="field pm-full">
            <label asp-for="Note">Açıklama</label>
            <div class="has-mic"><input asp-for="Note" spellcheck="true" lang="tr" autocomplete="off" placeholder="Örn. Yüzük A12 için kapora" /><button type="button" class="mic-btn" title="Sesle yaz (Türkçe)" aria-label="Sesle yaz (Türkçe)"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11z" /></svg></button></div>
        </div>
    </div>

    <div class="pm-side">
        <aside class="pm-sum" id="pmSum">
            <div class="ps-head">Hesap Sonucu</div>
            <div class="ps-row"><span>Önceki bakiye</span><b id="psPrev">—</b></div>
            <div class="ps-row"><span>Bu ödeme</span><b id="psPay">—</b></div>
            <div class="ps-foot" id="psRestRow"><span>Kalan nakit</span><b id="psRest">—</b></div>
            @if (hasGold)
            {
                <div id="psGold">
                    <div class="ps-row"><span>Önceki altın borcu</span><b>@Fmt.Gr(Model.GoldRemaining)</b></div>
                    <div class="ps-row"><span>Bu ödeme (altın)</span><b id="psGPay">—</b></div>
                    <div class="ps-foot ps-gfoot" id="psGRestRow"><span>Kalan altın</span><b id="psGRest">@Fmt.Gr(Model.GoldRemaining)</b></div>
                </div>
            }
        </aside>
    </div>

    <div asp-validation-summary="All" class="pm-error error" id="pmError"></div>

    <div class="confirm-actions">
        @if (isNew && Model.CustomerId > 0 && Model.PrevBalance > 0)
        {
            <button type="button" class="btn secondary" id="pmCloseBal" title="Müşterinin kalan bakiyesinin tamamını tutar alanına yazar">Kalanı tahsil et</button>
        }
        <button type="button" class="btn secondary" data-close>Vazgeç</button>
        <button type="submit" class="btn">Kaydet</button>
    </div>
</form>
</div>
