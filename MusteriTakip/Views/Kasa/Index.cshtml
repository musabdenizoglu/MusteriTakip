@model KasaVm
@{
    // Görünüm referans musteritakip.html → #panelKasa ile aynı yapıdadır.
    ViewData["Title"] = "Kasa";
    ViewData["ContentClass"] = "kasa-mode";
    var t = Model.Totals;
    // HTML'de kasa listesi en son eklenen üstte sıralanır; yalnızca fiyatı olan siparişler listelenir
    var items = Model.Items.Where(m => m.Type is MovementType.Payment or MovementType.Expense || m.Rec?.Price != null)
                           .OrderByDescending(m => m.KasaSortAt).ToList();
}

<div class="home-panel active" id="panelKasa">
    <span class="back-pair"><a class="btn secondary panel-back" id="backFromKasaBtn" asp-controller="Home" asp-action="Index">← Ana Sayfaya Dön</a><button type="button" class="btn secondary back-step" title="Geri: önceki sayfaya dön" aria-label="Geri" data-back><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button></span>
    <partial name="_KasaTabs" model="@("panelKasa")" />
    <div class="card kasa-sum-card kasa-strip-card">
        <h2>Kasa Son Durumu</h2>
        <div class="kasa-strip">
            <div class="ks-group"><span class="ks-title">Dolar ($)</span>
                <div class="kasa-stats">
                    <div class="kasa-stat"><span class="label">Ciro</span><span class="amount" id="kasaTotalPrice" data-sync>@Fmt.Usd(t.Ciro)</span></div>
                    <div class="kasa-stat"><span class="label">Tahsilat</span><span class="amount" id="kasaTotalPaid" data-sync>@Fmt.Usd(t.Tahsilat)</span></div>
                    <div class="kasa-stat"><span class="label">Gider</span><span class="amount" id="kasaTotalExpense" data-sync>@Fmt.Usd(t.GiderUsd)</span><span class="sub" id="kasaExpenseTl" data-sync>@(t.GiderTl > 0 ? Fmt.Tl(t.GiderTl) : "")</span></div>
                    <div class="kasa-stat result"><span class="label">Kasa Bakiye</span><span class="amount@(t.Bakiye < 0 ? " neg" : "")" id="kasaRemaining" data-sync>@Fmt.Usd(t.Bakiye)</span></div>
                </div>
            </div>
            <div class="ks-group"><span class="ks-title">Altın (gr)</span>
                <div class="kasa-stats kasa-gold-stats">
                    <div class="kasa-stat"><span class="label">Toplam Altın Ciro</span><span class="amount" id="kasaGoldTotal" data-sync>@Fmt.Gr(t.GoldTotal)</span></div>
                    <div class="kasa-stat"><span class="label">Alınan Altın Ödeme</span><span class="amount" id="kasaGoldPaid" data-sync>@Fmt.Gr(t.GoldPaid)</span></div>
                    <div class="kasa-stat result"><span class="label">Kalan Altın Bakiye</span><span class="amount" id="kasaGoldRemaining" data-sync>@Fmt.Gr(t.GoldRest)</span><span class="sub gold-val" id="kasaGoldValue" data-sync data-gold-value="@Fmt.Input(t.GoldRest)"></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="card activity-card kasa-list-card">
        <div class="records-head kasa-head">
            <h2>Hareketler</h2>
            <div class="kasa-head-btns">
                <a class="qa" id="kasaOpenPayBtn" data-modal asp-controller="Payments" asp-action="Create" asp-route-fromKasa="true"><span class="qa-i k-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"></rect><circle cx="12" cy="12.5" r="2.5"></circle><path d="M6 10v.01M18 15v.01"></path></svg></span>Ödeme Ekle</a>
                <a class="qa" id="kasaExpBtn" data-modal asp-controller="Expenses" asp-action="Create"><span class="qa-i k-red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l6 6 4-4 8 8"></path><path d="M15 17h6v-6"></path></svg></span>Gider Ekle</a>
                <a class="qa" id="kasaXlsxBtn" asp-action="Excel" title="Hareketleri Excel dosyasına aktar" aria-label="Hareketleri Excel dosyasına aktar"><span class="qa-i k-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"></rect><path d="M8 8l8 8M16 8l-8 8"></path></svg></span>Excel'e aktar</a>
            </div>
        </div>
        <div class="kasa-filter-row" style="display:none;"></div>
        <div class="kasa-period-sum" id="kasaPeriodSum"></div>
        <div id="kasaScroll">
            <div id="kasaSelBar" class="hist-selbar">
                <label class="hsel"><input type="checkbox" id="kasaSelAll" aria-label="Tümünü seç"> <span>Tümünü seç</span></label>
                <span id="kasaSelCnt" class="hsel-cnt"></span>
                <button type="button" class="btn secondary sm" id="kasaSelPdf" style="display:none">Seçileni PDF yap</button>
                <button type="button" class="btn secondary sm" id="kasaSelPng" style="display:none">Seçileni resim yap (.JPG)</button>
                <button type="button" class="btn secondary sm" id="kasaSelClear" style="display:none">Seçimi temizle</button>
                <button type="button" class="btn secondary sm" id="kasaSelDel" style="display:none">Seçilenleri sil</button>
                <form method="post" asp-action="DeleteSelected" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" id="kasaSelDelForm" hidden></form>
                <div class="hs-filter kasa-hs">
                    <div class="quick-search">
                        <label for="kasaSearch">Hızlı Arama</label>
                        <input type="text" id="kasaSearch" value="@Model.Search" placeholder="Müşteri, model, tarih, tür…" title="Borç / Ödeme / Gider yazabilir, virgülle birden fazla arama yapabilirsiniz" autocomplete="off">
                    </div>
                    <div class="kasa-period">
                        <label for="kasaPeriod">Dönem</label>
                        <select id="kasaPeriod" aria-label="Dönem">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.Period))">Dönem: Tümü</option>
                            <option value="m0" selected="@(Model.Period == "m0")">Bu ay</option>
                            <option value="m1" selected="@(Model.Period == "m1")">Geçen ay</option>
                            <option value="y0" selected="@(Model.Period == "y0")">Bu yıl</option>
                            <option value="y1" selected="@(Model.Period == "y1")">Geçen yıl</option>
                        </select>
                    </div>
                </div>
            </div>
            <div id="kasaList" data-sync="html">
                @foreach (var m in items)
                {
                    <partial name="_HistRow" model="m" view-data='new ViewDataDictionary(ViewData) { ["Mode"] = "kasa" }' />
                }
            </div>
            <div class="empty-note" id="kasaEmptyNote" style="@(items.Count == 0 ? "" : "display:none;")"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var $ = function (id) { return document.getElementById(id); };
            var list = $('kasaList'), inp = $('kasaSearch'), per = $('kasaPeriod');
            function inPeriod(r) {
                var p = per.value; if (!p) return true;
                var d = new Date(), y = d.getFullYear(), mo = d.getMonth(), from, to;
                if (p === 'm0') { from = new Date(y, mo, 1); to = new Date(y, mo + 1, 1); }
                else if (p === 'm1') { from = new Date(y, mo - 1, 1); to = new Date(y, mo, 1); }
                else if (p === 'y0') { from = new Date(y, 0, 1); to = new Date(y + 1, 0, 1); }
                else { from = new Date(y - 1, 0, 1); to = new Date(y, 0, 1); }
                var x = new Date(r.dataset.d + 'T00:00:00'); return x >= from && x < to;
            }
            function apply() {
                var q = inp.value.toLocaleLowerCase('tr-TR').split(',').map(function (s) { return s.trim(); }).filter(Boolean), n = 0;
                list.querySelectorAll('.hist-row').forEach(function (r) {
                    var ok = q.every(function (t) { return r.dataset.s.indexOf(t) >= 0; }) && inPeriod(r);
                    mtHide(r, !ok); if (ok) n++;
                });
                var total = list.querySelectorAll('.hist-row').length, nf = !n && total > 0;
                if (nf && per.value && !q.length) mtEmptyNf('kasaEmptyNote', true, 'Bu dönemde hareket yok', 'Seçilen dönemde kayıt yok. Başka bir dönem seçin.');
                else mtEmptyNf('kasaEmptyNote', nf);
                // Liste boşken 320px'lik kutu gizlenir, mesaj kalan alanın ortasında durur
                mtHide(list, !n); $('kasaScroll').classList.toggle('is-empty', !n);
                $('kasaEmptyNote').style.display = n ? 'none' : '';
            }
            inp.addEventListener('input', apply); per.addEventListener('change', apply); apply();
            // Satıra tıklayınca müşteri / giderler sayfası
            list.addEventListener('click', function (e) {
                if (e.target.closest('.hsel-cell, .row-actions')) return;
                var r = e.target.closest('.hist-row[data-href]'); if (r) location.href = r.dataset.href;
            });
            // Tümünü seç + sayaç
            var all = $('kasaSelAll'), cnt = $('kasaSelCnt');
            function upd() {
                var boxes = list.querySelectorAll('.hsel-box'), k = list.querySelectorAll('.hsel-box:checked').length;
                all.checked = boxes.length > 0 && k === boxes.length; all.indeterminate = k > 0 && !all.checked;
                cnt.textContent = k ? k + ' kayıt seçili' : '';
                ['kasaSelPdf', 'kasaSelPng', 'kasaSelClear', 'kasaSelDel'].forEach(function (id) { $(id).style.display = k ? '' : 'none'; });
            }
            all.addEventListener('change', function () { list.querySelectorAll('.hist-row:not([hidden]) .hsel-box').forEach(function (b) { b.checked = all.checked; }); upd(); });
            list.addEventListener('change', function (e) { if (e.target.classList.contains('hsel-box')) upd(); });
            // Seçilenlerle PDF / JPG / temizle / sil (HTML: kasaStatement, deleteKasaSelected)
            function keys() { return Array.prototype.map.call(list.querySelectorAll('.hsel-box:checked'), function (b) { return b.dataset.key; }); }
            var selQ = function () { return '?sel=' + encodeURIComponent(keys().join(',')); };
            $('kasaSelPdf').addEventListener('click', function () { if (keys().length) mtStmt.pdf('@Url.Action("Statement")' + selQ(), this); });
            $('kasaSelPng').addEventListener('click', function () { if (keys().length) mtStmt.jpg('@Url.Action("StatementData")' + selQ(), this); });
            $('kasaSelClear').addEventListener('click', function () { list.querySelectorAll('.hsel-box').forEach(function (b) { b.checked = false; }); upd(); });
            $('kasaSelDel').addEventListener('click', function () {
                var k = keys(); if (!k.length) return;
                var nPay = k.filter(function (s) { return s.indexOf('payment:') === 0; }).length, nRec = k.length - nPay, parts = [];
                if (nPay) parts.push(nPay + ' ödeme'); if (nRec) parts.push(nRec + ' borç');
                var f = $('kasaSelDelForm');
                f.querySelectorAll('input[name="keys"]').forEach(function (i) { i.remove(); });
                k.forEach(function (s) { var i = document.createElement('input'); i.type = 'hidden'; i.name = 'keys'; i.value = s; f.appendChild(i); });
                mtAsk('Seçili ' + k.length + ' kaydı (' + parts.join(', ') + ') silmek istediğinize emin misiniz?', { okLabel: 'Sil', cancelLabel: 'Vazgeç', onOk: function () { f.submit(); } });
            });
        })();
    </script>
}
