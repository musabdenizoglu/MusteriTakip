@model StatementVm
@{
    // Referans musteritakip.html → buildStatement() ile aynı düzen
    Layout = null;
    var c = Model.Customer;
    var sel = Model.Sel != null;
    var embed = ViewData["Embed"] as bool? == true;
    var moves = Model.Rows.Where(r => !r.IsCarry).ToList();
    var part = sel || Model.From != null || Model.To != null;
    var debt = part ? moves.Sum(r => r.Debt) : Model.Totals.Ciro;
    var pay = part ? moves.Sum(r => r.Pay) : Model.Totals.Paid;
    var rest = part ? (Model.Rows.Count > 0 ? Model.Rows[^1].Balance : 0m) : Model.Totals.Rest;
    var now = DateTime.Now;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Hesap Ekstresi @c.Name @Fmt.Date(Dates.Today)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="print-page">
    @if (!embed)
    {
        <form method="get" class="no-print stmt-bar">
            <label>Başlangıç <input type="date" name="from" value="@Fmt.InputDate(Model.From)" /></label>
            <label>Bitiş <input type="date" name="to" value="@Fmt.InputDate(Model.To)" /></label>
            @if (sel)
            {<input type="hidden" name="sel" value="@Model.Sel" />}
            <button class="btn" type="submit">Uygula</button>
            <button class="btn secondary" type="button" onclick="window.print()">⎙ Yazdır / PDF kaydet</button>
            <a class="btn secondary" asp-action="Details" asp-route-id="@c.Id">← Müşteriye dön</a>
        </form>
    }

    @* Uygulamanın yazdırma kuralı yalnız #printArea'yı basar *@
    <div id="printArea" style="display:block">
    <div class="st-head">
        <div><h1>Hesap Ekstresi</h1><div>@Model.ShopName</div></div>
        <div class="st-meta">Düzenlenme: @now.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    <p class="st-cust">@c.Name</p>
    @if (!string.IsNullOrWhiteSpace(c.Phone))
    {<div>Tel: @c.Phone</div>}
    @if (!string.IsNullOrWhiteSpace(c.Code))
    {<div>Müşteri kodu: @c.Code</div>}
    @if (sel)
    {<div>Seçili kayıtlar (@moves.Count)</div>}
    else if (Model.From != null || Model.To != null)
    {<div>Dönem: @(Model.From == null ? "Başlangıç" : Fmt.Date(Model.From)) – @Fmt.Date(Model.To ?? Dates.Today)</div>}

    <div class="st-sum">
        <div><span>@(sel ? "Seçilenlerin borcu" : "Toplam (borç)")</span><b>@Fmt.Usd(debt)</b></div>
        <div><span>Ödenen</span><b>@Fmt.Usd(pay)</b></div>
        <div><span>@(rest < 0 ? "Alacak" : (sel ? "Fark" : "Kalan Bakiye"))</span><b>@Fmt.Usd(Math.Abs(rest))</b></div>
    </div>

    <h2 class="st-h2">Hesap hareketleri</h2>
    <table class="st-table">
        <thead><tr><th>Tarih</th><th>Açıklama</th><th>Borç</th><th>Ödeme</th><th>Bakiye</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr class="@(r.IsCarry ? "carry" : "")">
                    <td>@Fmt.Date(r.Date)</td>
                    <td>@if (r.IsCarry)
                        {<i>@r.Description</i>}
                        else
                        {@r.Description}</td>
                    <td class="n">@(r.Debt > 0 ? Fmt.Usd(r.Debt) : "")</td>
                    <td class="n">@(r.Pay > 0 ? Fmt.Usd(r.Pay) : "")</td>
                    <td class="n">@Fmt.Usd(r.Balance)</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {<tr><td colspan="5">Hareket yok.</td></tr>}
        </tbody>
        <tfoot><tr><td colspan="2">@(sel ? "Seçilenlerin toplamı" : (Model.From != null ? "Dönem toplamı" : "Toplam"))</td><td class="n">@Fmt.Usd(debt)</td><td class="n">@Fmt.Usd(pay)</td><td class="n">@Fmt.Usd(rest)</td></tr></tfoot>
    </table>

    @if (!sel)
    {
        <h2 class="st-h2">Altın hesabı (tüm zamanlar)</h2>
        <table class="st-table">
            <thead><tr><th>Toplam altın ciro</th><th>Alınan altın ödeme</th><th>Kalan altın</th></tr></thead>
            <tbody><tr><td class="n">@Fmt.Gr(Model.Totals.GoldTotal)</td><td class="n">@Fmt.Gr(Model.Totals.GoldPaid)</td><td class="n">@Fmt.Gr(Model.Totals.GoldRest)</td></tr></tbody>
        </table>
    }

    <p class="st-foot">Tutarlar ABD doları ($) cinsindendir.</p>
    </div>
    @if (Model.AutoPrint)
    {<script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 250); });</script>}
</body>
</html>
