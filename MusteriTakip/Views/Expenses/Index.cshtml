@model ExpensesVm
@{
    // Görünüm referans musteritakip.html → #panelGiderler ile aynı yapıdadır.
    // "Gider Ekle" ve "Düzenle" pencereleri (Expenses/Form) data-modal ile sayfa yenilenmeden açılır ve kaydedilir.
    ViewData["Title"] = "Giderler";
    ViewData["ContentClass"] = "exp-mode";
    const string ExpIco = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7l6 6 4-4 8 8\"></path><path d=\"M15 17h6v-6\"></path></svg>";
}

<div class="home-panel active" id="panelGiderler">
    <div class="seg-row">
        <span class="back-pair"><a class="btn secondary panel-back" id="backFromGiderlerBtn" asp-controller="Home" asp-action="Index">← Ana Sayfaya Dön</a><button type="button" class="btn secondary back-step" title="Geri: önceki sayfaya dön" aria-label="Geri" data-back><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button></span>
        <partial name="_KasaTabs" model="@("panelGiderler")" />
        <a class="qa" id="giderOpenBtn" data-modal asp-action="Create"><span class="qa-i k-red">@Html.Raw(ExpIco)</span>Gider Ekle</a>
    </div>
    <div class="card activity-card exp-list-card">
        <div class="records-head exp-head"><h2>Giderler</h2></div>
        <div id="expenseList" data-sync="html">
            @foreach (var e in Model.Items)
            {
                var usd = LedgerService.ExpenseUsd(e);
                var note = (e.Note ?? "").Trim();
                <div class="hist-row" data-rec="expense:@e.Id">
                    <span class="hist-desc" style="font-weight:600;flex:1.3;"><span class="exp-type-in"><span class="exp-tag-line first"><span class="kind-tag k-gider">@LedgerService.ExpenseLabel(e)</span></span>@if (e.Rate > 0)
                        {<span class="exp-rate">kur @Ui.Rate(e.Rate.Value)</span>}</span></span>
                    <span class="exp-note-col@(note == "" ? " empty" : "")" title="@note">@(note == "" ? "—" : note)</span>
                    <span class="hist-date">@Fmt.Date(e.Date)</span>
                    <span class="hist-amount exp-amt"><span class="exp-tl">@Fmt.Tl(e.Amount)</span>@if (usd != null)
                        {<span class="exp-usd">@Fmt.Usd(usd)</span>}
                        else
                        {<span class="usd-missing">kur girilmedi</span>}</span>
                    <div class="row-actions">
                        <button type="button" class="edit" data-modal data-href="@Url.Action("Edit", new { id = e.Id })" title="Düzenle" aria-label="Düzenle: @LedgerService.ExpenseLabel(e), @Fmt.Date(e.Date)">✎</button>
                        <form method="post" asp-action="Delete" asp-route-id="@e.Id" class="inline" data-confirm="Bu gider çöp kutusuna taşınsın mı?"><button class="del" type="submit" title="Sil" aria-label="Sil: @LedgerService.ExpenseLabel(e), @Fmt.Date(e.Date)">✕</button></form>
                    </div>
                </div>
            }
        </div>
        @* Her zaman yazılır (gizli/açık): ilk gider sayfa yenilenmeden eklenince de doğru kaybolur *@
        <div class="empty-note" id="expenseEmptyNote" data-sync hidden="@(Model.Items.Count > 0)"><div class="es"><div class="es-t">Henüz gider yok</div><div class="es-s">“Gider Ekle” ile ilk giderinizi ekleyin; kategoriye göre raporlanır.</div></div></div>
    </div>
</div>

@section Scripts {
    <script>
        // Başka sayfadan "#giderForm" ile gelindiyse "Gider Ekle" penceresini aç
        if (location.hash === '#giderForm') { var b = document.getElementById('giderOpenBtn'); if (b) b.click(); }
    </script>
}
