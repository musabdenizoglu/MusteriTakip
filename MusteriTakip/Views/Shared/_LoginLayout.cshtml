<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Müşteri Takip</title>
    <script>try { var m = localStorage.getItem("mt_mode"); if (m) document.documentElement.setAttribute("data-theme", m); var t = localStorage.getItem("mt_theme"); if (t && t !== "orijinal") document.documentElement.setAttribute("data-skin", t); } catch (e) { }</script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            @RenderBody()
        </div>
    </div>
</body>
</html>
