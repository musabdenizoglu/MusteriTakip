@inject SettingsService SettingsSvc
@{
    // Sayfa iskeleti referans musteritakip.html'deki "Kurumsal Mavi" düzeninin birebir karşılığıdır:
    // #mainScreen > .topbar  +  #mainContent > ... > .home-content > .home-panel  +  sol menü #fmSide
    var st = await SettingsSvc.GetAsync();
    var shop = string.IsNullOrWhiteSpace(st.ShopName) ? "Müşteri Takip" : st.ShopName;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    var display = Ui.Cap(userName);

    // Sol menüde hangi öğe seçili? (HTML: PANEL eşlemesi)
    var nav = ViewData["Nav"] as string ?? ctrl switch
    {
        "Home" => "home",
        "Orders" => "order",
        "Customers" => act == "Create" ? "newcust" : "cust",
        "Payments" => "cust",
        "Kasa" => "kasa",
        "Expenses" => "gider",
        "Reports" => "rapor",
        "Settings" or "Trash" or "Backup" => "ayar",
        _ => ""
    };
    string On(string k) => nav == k ? " on" : "";
    bool custGrp = nav is "cust" or "newcust";
    bool kasaGrp = nav is "kasa" or "gider" or "rapor";
    var contentCls = ViewData["ContentClass"] as string ?? "";
}
<!DOCTYPE html>
<html lang="tr" data-skin="kurumsal" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0072BC" />
    <meta name="format-detection" content="telephone=no" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")@shop</title>
    <script>
        // Koyu mod ve daraltılmış menü tarayıcıda hatırlanır — sayfa çizilmeden uygulanır
        (function () {
            var h = document.documentElement;
            try {
                if (localStorage.getItem("mt_mode") === "dark") h.setAttribute("data-theme", "dark");
                var f = localStorage.getItem("mt_fs"); if (f === "l" || f === "xl") h.setAttribute("data-fs", f);
                if (localStorage.getItem("mt_fmcol") === "1") h.classList.add("fm-col");
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mvc.css" asp-append-version="true" />
</head>
<body>
    <div id="mainScreen" style="display:block">
        <div class="topbar">
            <button type="button" id="fmBurger" aria-label="Menüyü aç/kapat" title="Menüyü daralt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path><path d="M20 4v16"></path></svg></button>
            <h1 id="appTitle" data-i="@shop[..1]">@shop</h1>
            <form class="gsearch" id="gSearch" method="get" asp-controller="Customers" asp-action="Index" role="search">
                <span class="gs-ic">🔍</span><input type="search" id="gsInput" name="q" placeholder="Ara: müşteri, kod, model…" autocomplete="off" aria-label="Genel arama"><span class="gs-k">Ctrl K</span>
            </form>
            <div class="live-ticker" id="liveTicker" title="Canlı piyasa fiyatları (her dakika yenilenir)">
                <div class="lt-item"><span class="lt-name">Dolar</span><span class="lt-v"><small>Alış</small><b id="ltUsdBuy">—</b></span><span class="lt-v"><small>Satış</small><b id="ltUsdSell">—</b></span></div>
                <div class="lt-item"><span class="lt-name">Euro</span><span class="lt-v"><small>Alış</small><b id="ltEurBuy">—</b></span><span class="lt-v"><small>Satış</small><b id="ltEurSell">—</b></span></div>
                <div class="lt-item"><span class="lt-name">Gram Altın</span><span class="lt-v"><small>Alış</small><b id="ltGoldBuy">—</b></span><span class="lt-v"><small>Satış</small><b id="ltGoldSell">—</b></span></div>
            </div>
            <div class="topbar-actions">
                <button class="logout mode-btn" id="modeBtn" type="button" title="Koyu / açık görünüm">🌙</button>
            </div>
            <div class="fm-icons">
                <a class="bk-chip" id="bkChip" asp-controller="Backup" asp-action="Export" title="Tıklayınca şimdi yedek alır"><i></i><span class="bk-w">Yedek:</span> <b id="bkChipT">—</b></a>
                <button type="button" class="fm-ib" id="fmMode" title="Koyu görünüme geç" aria-label="Koyu / açık görünüm"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg></button>
                <div class="fm-user" id="fmUser">
                    <span class="av">@(display.Length > 0 ? display[..1] : "?")</span><span class="car"></span>
                    <div class="fm-umenu">
                        <b>@display</b><small>Yönetici</small>
                        <form method="post" asp-controller="Account" asp-action="Logout"><button type="submit" data-a="out">Çıkış yap</button></form>
                    </div>
                </div>
            </div>
        </div>

        <div class="screen active" id="mainContent">
            <div class="view-slot">
                <div class="view active" id="homeView">
                    <div class="home-layout">
                        <div class="home-content @contentCls">
                            @if (TempData["Ok"] is string ok)
                            {
                                <div class="flash ok" role="status">@ok</div>
                            }
                            @if (TempData["Error"] is string er)
                            {
                                <div class="flash err" role="alert">@er</div>
                            }
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <nav id="fmSide">
        <a class="fm-logo" asp-controller="Home" asp-action="Index"><i>@shop[..1]</i><b>@shop</b></a>
        <a class="fm-item@(On("home"))" data-k="home" asp-controller="Home" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M3.5 11 12 4l8.5 7"></path><path d="M5.5 10v9.5h5v-5h3v5h5V10"></path></svg><span class="fm-lbl">Ana Sayfa</span></a>
        <a class="fm-item@(On("order"))" data-k="order" data-modal asp-controller="Orders" asp-action="New"><svg viewBox="0 0 24 24" style="fill:currentColor;stroke:none"><path d="M9 2h6l2 3-5 4-5-4zm3 8a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 10a4 4 0 1 1 4-4 4 4 0 0 1-4 4z"></path></svg><span class="fm-lbl">Yeni Sipariş</span></a>
        <div class="fm-grp@(custGrp ? " act open" : "")" data-g="cust" data-main="cust">
            <button type="button" class="fm-ghead" data-href="@Url.Action("Index", "Customers")"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"></circle><path d="M5 20c.6-3.6 3.4-5.6 7-5.6s6.4 2 7 5.6"></path></svg><span class="fm-lbl">Müşteriler</span></button>
            <div class="fm-kids">
                <a class="fm-kid@(On("cust"))" data-k="cust" asp-controller="Customers" asp-action="Index">Müşteriler</a>
                <a class="fm-kid@(On("newcust"))" data-k="newcust" asp-controller="Customers" asp-action="Create">Yeni Müşteri</a>
            </div>
        </div>
        <div class="fm-grp@(kasaGrp ? " act open" : "")" data-g="kasa">
            <button type="button" class="fm-ghead" data-href="@Url.Action("Index", "Kasa")"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18M16 15h2"></path></svg><span class="fm-lbl">Kasa</span></button>
            <div class="fm-kids">
                <a class="fm-kid@(On("kasa"))" data-k="kasa" asp-controller="Kasa" asp-action="Index">Hareketler</a>
                <a class="fm-kid@(On("gider"))" data-k="gider" asp-controller="Expenses" asp-action="Index">Giderler</a>
                <a class="fm-kid@(On("rapor"))" data-k="rapor" asp-controller="Reports" asp-action="Index">Raporlar</a>
            </div>
        </div>
        <a class="fm-item@(On("ayar"))" data-k="ayar" asp-controller="Settings" asp-action="Index"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 14.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3h0a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8v0a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z"></path></svg><span class="fm-lbl">Ayarlar</span></a>
        <div class="fm-sp"></div>
        <a class="fm-item small" asp-controller="Backup" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M12 16V5M7 9l5-5 5 5M5 20h14"></path></svg><span class="fm-lbl">Yedeği Yükle</span></a>
    </nav>

    <nav class="m-tabbar" id="mTabbar" aria-label="Alt menü">
        <a class="@(nav == "home" ? "on" : "")" data-mt="home" asp-controller="Home" asp-action="Index"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 11l9-7 9 7" /><path d="M5 10v10h14V10" /></svg><span>Ana Sayfa</span></a>
        <a class="@(custGrp ? "on" : "")" data-mt="cust" asp-controller="Customers" asp-action="Index"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="9" r="3.5" /><path d="M3.5 21c.8-3.8 3.3-6 6.5-6s5.7 2.2 6.5 6" /><path d="M19 2.5v6M16 5.5h6" /></svg><span>Müşteriler</span></a>
        <a class="mt-order" data-mt="order" data-modal asp-controller="Orders" asp-action="New"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 2h6l2 3-5 4-5-4zm3 8a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 10a4 4 0 1 1 4-4 4 4 0 0 1-4 4z" /></svg><span>Sipariş</span></a>
        <a class="@(kasaGrp ? "on" : "")" data-mt="kasa" asp-controller="Kasa" asp-action="Index"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18" /></svg><span>Kasa</span></a>
        <a class="@(nav == "ayar" ? "on" : "")" data-mt="menu" asp-controller="Settings" asp-action="Index"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><span>Menü</span></a>
    </nav>

    <div class="img-modal" id="imgModal"><button type="button" class="modal-close" aria-label="Kapat">✕</button><img id="imgModalImg" alt="" /><div class="modal-caption" id="imgModalCap"></div></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui-polish.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
