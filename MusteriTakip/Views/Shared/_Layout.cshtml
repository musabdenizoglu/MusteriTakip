@inject SettingsService SettingsSvc
@{
    var st = await SettingsSvc.GetAsync();
    var shop = string.IsNullOrWhiteSpace(st.ShopName) ? "Müşteri Takip" : st.ShopName;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var display = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "";
    string On(string c, string? a = null) => ctrl == c && (a == null || act == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2E6F5E" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")@shop</title>
    <script>
        // Tema ve koyu mod (tarayıcıda hatırlanır) — sayfa çizilmeden uygulanır
        (function () {
            try {
                var t = localStorage.getItem("mt_theme"); if (t && t !== "orijinal") document.documentElement.setAttribute("data-skin", t);
                var m = localStorage.getItem("mt_mode"); if (m) document.documentElement.setAttribute("data-theme", m);
                var f = localStorage.getItem("mt_fs"); if (f === "l" || f === "xl") document.documentElement.setAttribute("data-fs", f);
                if (localStorage.getItem("mt_side_mini") === "1") document.documentElement.classList.add("side-mini");
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">@shop</a>
        <form class="gsearch" method="get" asp-controller="Home" asp-action="Index">
            <span class="gs-ic">🔍</span>
            <input type="search" name="q" placeholder="Ara: müşteri, kod, model…" autocomplete="off" aria-label="Genel arama" />
        </form>
        <div class="live-ticker" id="liveTicker" title="Canlı piyasa fiyatları (her dakika yenilenir)">
            <div class="lt-item"><span class="lt-name">Dolar</span><span class="lt-v"><small>Alış</small><b id="ltUsdBuy">—</b></span><span class="lt-v"><small>Satış</small><b id="ltUsdSell">—</b></span></div>
            <div class="lt-item"><span class="lt-name">Gram Altın</span><span class="lt-v"><small>Alış</small><b id="ltGoldBuy">—</b></span><span class="lt-v"><small>Satış</small><b id="ltGoldSell">—</b></span></div>
        </div>
        <div class="topbar-actions">
            <button class="logout mode-btn" id="modeBtn" type="button" title="Koyu / açık görünüm">🌙</button>
            <form method="post" asp-controller="Account" asp-action="Logout" class="inline">
                <button class="logout" type="submit">Çıkış yap</button>
            </form>
        </div>
    </header>

    <div class="home-layout">
        <nav class="home-sidebar">
            <div class="side-user"><i>@Fmt.Initials(display)</i><div><b>@display</b><small>Yönetici</small></div></div>
            <button type="button" class="side-toggle" id="sideToggle" title="Menüyü daralt">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /><path d="M20 4v16" /></svg>
            </button>
            <a class="home-btn @On("Home")" asp-controller="Home" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span class="nav-lbl">Ana Sayfa</span></a>
            <a class="home-btn yellow @On("Orders")" asp-controller="Orders" asp-action="New"><span class="nav-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 2h6l2 3-5 4-5-4zm3 8a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 10a4 4 0 1 1 4-4 4 4 0 0 1-4 4z" /></svg></span><span class="nav-lbl">Yeni Sipariş</span></a>
            <a class="home-btn @On("Customers", "Create")" asp-controller="Customers" asp-action="Create"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="8" r="4" /><path d="M3 21c1-4 4-6 7-6M18 14v6M15 17h6" /></svg></span><span class="nav-lbl">Müşteri Kaydı</span></a>
            <a class="home-btn @(ctrl == "Customers" && act != "Create" ? "active" : "")" asp-controller="Customers" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="9" r="3.5" /><path d="M3.5 21c.8-3.8 3.3-6 6.5-6s5.7 2.2 6.5 6" /></svg></span><span class="nav-lbl">Müşteriler</span></a>
            <a class="home-btn @On("Kasa") @On("Payments")" asp-controller="Kasa" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18M7 15h4" /></svg></span><span class="nav-lbl">Genel Kasa</span></a>
            <a class="home-btn @On("Expenses")" asp-controller="Expenses" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M17 7H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6" /></svg></span><span class="nav-lbl">Giderler</span></a>
            <a class="home-btn @On("Reports")" asp-controller="Reports" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3a9 9 0 1 0 9 9h-9z" /><path d="M15 3.5A9 9 0 0 1 20.5 9H15z" /></svg></span><span class="nav-lbl">Raporlar</span></a>
            <a class="home-btn @On("Settings") @On("Trash")" asp-controller="Settings" asp-action="Index"><span class="nav-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" /></svg></span><span class="nav-lbl">Ayarlar</span></a>
            <div class="side-backup">
                <a class="backup-btn yellow" asp-controller="Backup" asp-action="Export" title="Tüm kayıtları bir yedek dosyasına kaydet">⬇ <span class="bk-t">Yedek Al</span></a>
                <a class="backup-btn yellow" asp-controller="Backup" asp-action="Index" title="Yedekteki kayıtları geri yükle">⬆ <span class="bk-t">Yükle</span></a>
            </div>
        </nav>

        <main class="home-content">
            @if (TempData["Ok"] is string ok)
            {
                <div class="flash ok" role="status">@ok</div>
            }
            @if (TempData["Error"] is string er)
            {
                <div class="flash err" role="alert">@er</div>
            }
            @RenderBody()
        </main>
    </div>

    <nav class="m-tabbar">
        <a class="@On("Home")" asp-controller="Home" asp-action="Index">🏠<span>Ana</span></a>
        <a class="@(ctrl == "Customers" ? "on" : "")" asp-controller="Customers" asp-action="Index">👥<span>Müşteri</span></a>
        <a class="mt-order" asp-controller="Orders" asp-action="New">＋<span>Sipariş</span></a>
        <a class="@On("Kasa")" asp-controller="Kasa" asp-action="Index">💵<span>Kasa</span></a>
        <a class="@On("Settings")" asp-controller="Settings" asp-action="Index">⚙<span>Ayar</span></a>
    </nav>

    <div class="img-modal" id="imgModal"><button type="button" class="modal-close" aria-label="Kapat">✕</button><img id="imgModalImg" alt="" /><div class="modal-caption" id="imgModalCap"></div></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
